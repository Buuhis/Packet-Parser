###############################################################################
# Global
###############################################################################

VERSION=1
TOPOLOGY_PATH=server1,server2


###############################################################################
# ============================== SERVER 1 =====================================
###############################################################################

SERVER1_ID=server1
SERVER1_ROLE=server
SERVER1_LOCAL_IF=enp7s0
SERVER1_REMOTE_CIDR=192.168.182.0/24

# ---- LAN (towards client1/client2 side depending on topology) ----
SERVER1_LAN_IP=192.168.9.1/24
SERVER1_LAN_GW=192.168.9.2
SERVER1_LAN_DST_MAC=20:7c:14:f8:0d:08

# ---- WAN interfaces ----
SERVER1_WANS_COUNT=3

SERVER1_WANS_0_NAME=wan0
SERVER1_WANS_0_IFNAME=enp4s0
SERVER1_WANS_0_GATEWAY=192.168.11.2
SERVER1_WANS_0_WEIGHT=1
SERVER1_WANS_0_DST_MAC=20:7c:14:f8:0d:4d

SERVER1_WANS_1_NAME=wan1
SERVER1_WANS_1_IFNAME=enp5s0
SERVER1_WANS_1_GATEWAY=192.168.131.2
SERVER1_WANS_1_WEIGHT=1
SERVER1_WANS_1_DST_MAC=20:7c:14:f8:0d:4e 

SERVER1_WANS_2_NAME=wan2
SERVER1_WANS_2_IFNAME=enp6s0
SERVER1_WANS_2_GATEWAY=192.168.203.2
SERVER1_WANS_2_WEIGHT=1
SERVER1_WANS_2_DST_MAC=20:7c:14:f8:0d:4f


# ---- NE Tunnel (logical tunnel abstraction, parallel to WAN) ----
SERVER1_NE_TUNNEL_COUNT=3

SERVER1_NE_TUNNEL_0_NAME=ne_tunnel1
SERVER1_NE_TUNNEL_0_IFNAME=ne_tunnel1
SERVER1_NE_TUNNEL_0_GATEWAY=172.16.23.2 
SERVER1_NE_TUNNEL_0_WEIGHT=1 
SERVER1_NE_TUNNEL_0_DST_MAC=

# ---- Dataplane (unified TX + RX) ----
SERVER1_DATAPLANE_VETH_IN=veth_in
SERVER1_DATAPLANE_VETH_OUT=veth_out
SERVER1_DATAPLANE_MTU=1500


###############################################################################
# ============================== SERVER 2 =====================================
###############################################################################

SERVER2_ID=server2
SERVER2_ROLE=server

# ---- basic routing ----
SERVER2_LOCAL_IF=enp7s0
SERVER2_REMOTE_CIDR=192.168.9.0/24

# ---- LAN ----
SERVER2_LAN_IP=192.168.182.1/24
SERVER2_LAN_GW=192.168.182.2
SERVER2_LAN_DST_MAC=20:7c:14:f8:0c:f6

# ---- WAN interfaces ----
SERVER2_WANS_COUNT=3

SERVER2_WANS_0_NAME=wan0
SERVER2_WANS_0_IFNAME=enp4s0
SERVER2_WANS_0_GATEWAY=192.168.11.1
SERVER2_WANS_0_WEIGHT=1
SERVER2_WANS_0_DST_MAC=20:7c:14:f8:0c:cf 

SERVER2_WANS_1_NAME=wan1
SERVER2_WANS_1_IFNAME=enp5s0
SERVER2_WANS_1_GATEWAY=192.168.131.1
SERVER2_WANS_1_WEIGHT=1
SERVER2_WANS_1_DST_MAC=20:7c:14:f8:0c:d0 

SERVER2_WANS_2_NAME=wan2
SERVER2_WANS_2_IFNAME=enp6s0
SERVER2_WANS_2_GATEWAY=192.168.203.1
SERVER2_WANS_2_WEIGHT=1
SERVER2_WANS_2_DST_MAC=20:7c:14:f8:0c:d1 


# ---- NE Tunnel ----
SERVER2_NE_TUNNEL_COUNT=3

SERVER2_NE_TUNNEL_0_NAME=ne_tunnel1
SERVER2_NE_TUNNEL_0_IFNAME=ne_tunnel1
SERVER2_NE_TUNNEL_0_GATEWAY=172.16.23.1
SERVER2_NE_TUNNEL_0_WEIGHT=1
SERVER2_NE_TUNNEL_0_DST_MAC=

# ---- Dataplane ----
SERVER2_DATAPLANE_VETH_IN=veth_in
SERVER2_DATAPLANE_VETH_OUT=veth_out
SERVER2_DATAPLANE_MTU=1500

