[Unit]
Description=Multi-WAN Packet Forwarder Daemon
After=network.target postgresql.service

[Service]
Type=simple
User=root
# ENV
Environment="DB_HOST=127.0.0.1"
Environment="DB_PORT=5432"
Environment="DB_USER=postgres"
Environment="DB_NAME=mydb"
Environment="DB_PASS=anh_dien_mat_khau"
Environment="MWAN_SOCKET_PATH=/var/run/sep-wan.sock"

# Daemon
ExecStart=/usr/local/bin/sep-wan
Restart=always

[Install]
WantedBy=multi-user.target
