[Unit]
Description=Multi-WAN Packet Forwarder Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Create this root-only file during provisioning.  It contains POSTGRES_* and
# any Vault settings; a package must never ship deployment credentials.
EnvironmentFile=-/etc/sd-wan/sd-wan.env
Environment=LD_LIBRARY_PATH=/usr/lib/sd-wan

# Daemon
ExecStartPre=/sbin/modprobe mwan_kmod
ExecStart=/usr/sbin/sd-wan
ExecStopPost=-/sbin/rmmod mwan_kmod
Restart=always

[Install]
WantedBy=multi-user.target
